# Managed by Ansible
user nginx;
worker_processes auto;
error_log /var/log/nginx/error.log notice;
pid /run/nginx.pid;

include /usr/share/nginx/modules/*.conf;

events {
    worker_connections 1024;
}

http {
    log_format main '$remote_addr - $remote_user [$time_local] "$request" '
                    '$status $body_bytes_sent "$http_referer" '
                    '"$http_user_agent" "$http_x_forwarded_for"';
    access_log /var/log/nginx/access.log main;

    sendfile          on;
    tcp_nopush        on;
    keepalive_timeout 65;
    server_tokens     off;

    include      /etc/nginx/mime.types;
    default_type application/octet-stream;

    # Real client IP from the public ALB's X-Forwarded-For
    set_real_ip_from  {{ vpc_cidr }};
    real_ip_header    X-Forwarded-For;
    real_ip_recursive on;

    # TLS ends at the public ALB; pass the original scheme on to the app
    map $http_x_forwarded_proto $forwarded_proto {
        default $http_x_forwarded_proto;
        ""      $scheme;
    }

    # The internal ALB's IPs change over time. Using a variable in proxy_pass
    # makes nginx re-resolve the name instead of caching it forever at startup.
    resolver {{ nginx_resolver }} valid=30s ipv6=off;
    resolver_timeout 5s;

    server {
        listen      80 default_server;
        server_name _;

        set $app_backend "http://{{ app_backend_host }}";

        # Public ALB health check - nginx only, so one app outage
        # does not take every web node out of the pool
        location = /nginx-health {
            access_log off;
            default_type text/plain;
            return 200 "ok\n";
        }

        location /css/ {
            root {{ nginx_html_dir }};
            expires 7d;
            add_header Cache-Control "public";
        }
        location /js/ {
            root {{ nginx_html_dir }};
            expires 7d;
            add_header Cache-Control "public";
        }
        location /images/ {
            root {{ nginx_html_dir }};
            expires 7d;
            add_header Cache-Control "public";
        }

        location / {
            proxy_pass         $app_backend;
            proxy_set_header   Host              $host;
            proxy_set_header   X-Real-IP         $remote_addr;
            proxy_set_header   X-Forwarded-For   $proxy_add_x_forwarded_for;
            proxy_set_header   X-Forwarded-Proto $forwarded_proto;
            proxy_connect_timeout 5s;
            proxy_read_timeout    60s;
        }
    }
}
