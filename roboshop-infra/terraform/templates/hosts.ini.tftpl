# GENERATED BY TERRAFORM - do not edit by hand (terraform/inventory.tf)

[bastion]
bastion ansible_host=${bastion_ip}

[web]
%{ for i, ip in web_ips ~}
web-${i + 1} ansible_host=${ip}
%{ endfor ~}

[app]
%{ for i, ip in app_ips ~}
app-${i + 1} ansible_host=${ip}
%{ endfor ~}

[private:children]
web
app

# Private hosts are reached through the bastion
[private:vars]
ansible_ssh_common_args='-o StrictHostKeyChecking=accept-new -o ProxyCommand="ssh -i ${ssh_key} -o StrictHostKeyChecking=accept-new -W %h:%p -q ec2-user@${bastion_ip}"'

[all:vars]
ansible_user=ec2-user
ansible_ssh_private_key_file=${ssh_key}
aws_region=${aws_region}
vpc_cidr=${vpc_cidr}
app_backend_host=${app_backend_host}
db_host=${db_host}
db_password_ssm_param=${db_password_ssm}
